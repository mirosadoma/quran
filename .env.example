APP_NAME=Rattil
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://quran.test

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# Default timezone for new users and halaqat (all dates are stored in UTC)
APP_USER_TIMEZONE=Africa/Cairo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quran
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# null = realtime disabled (chat & notifications refresh automatically every few seconds)
# pusher / reverb = realtime enabled
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
# sync = jobs run immediately (easy local testing). Use "database" + a queue worker in production.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

INERTIA_SSR_ENABLED=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@rattil.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------
# Meetings: google_meet | zoom | jitsi | manual
# ---------------------------------------------------------------
MEETING_PROVIDER=jitsi

# Google Meet (recommended) — see PLAN.md section 10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/settings/google/callback"

# Zoom (Server-to-Server OAuth app)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Jitsi: public (meet.jit.si, opens in a new tab) | jaas (8x8, embedded) | self_hosted (embedded)
JITSI_MODE=public
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_APP_SECRET=
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY_PATH=storage/app/private/jaas.pem
JAAS_WEBHOOK_SECRET=

# Where downloaded meeting recordings are stored
RECORDINGS_DISK=public

# ---------------------------------------------------------------
# Realtime (Pusher free plan or Laravel Reverb)
# ---------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ---------------------------------------------------------------
# WhatsApp: log (writes to laravel.log) | cloud (Meta WhatsApp Cloud API)
# ---------------------------------------------------------------
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=ar

VITE_APP_NAME="${APP_NAME}"
