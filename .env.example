APP_NAME=Wird
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://quran.test

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# Default timezone for new users and halaqat (all dates are stored in UTC)
APP_USER_TIMEZONE=Africa/Cairo

# The first administration account on a server (php artisan db:seed), created only while there is none.
# Without a password a random one is shown once. Remove the password after the first sign-in.
ADMIN_NAME="إدارة المنصة"
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quran
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# null = realtime disabled (chat & notifications refresh automatically every few seconds)
# reverb = realtime enabled (the platform's own WebSocket server, see the Reverb section below)
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
# sync = jobs run immediately (easy local testing). Use "database" + a queue worker in production.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

INERTIA_SSR_ENABLED=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@rattil.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------
# Meetings: google_meet | zoom | jitsi | manual
# ---------------------------------------------------------------
MEETING_PROVIDER=jitsi

# Google Meet (recommended) — see PLAN.md section 10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/settings/google/callback"

# Zoom (Server-to-Server OAuth app)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Jitsi: public (meet.jit.si, opens in a new tab) | jaas (8x8, embedded) | self_hosted (embedded)
JITSI_MODE=public
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_APP_SECRET=
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY_PATH=storage/app/private/jaas.pem
JAAS_WEBHOOK_SECRET=

# Where downloaded meeting recordings are stored
RECORDINGS_DISK=public

# ---------------------------------------------------------------
# Realtime chat (Laravel Reverb): run php artisan reverb:start (Supervisor on the server)
# App ID / key / secret: any random values (php -r "echo bin2hex(random_bytes(16));").
# REVERB_HOST/PORT/SCHEME: where browsers reach Reverb (on the server: the domain, 443, https,
# with Nginx forwarding /app and /apps to REVERB_SERVER_HOST:REVERB_SERVER_PORT).
# ---------------------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Local machine opened over https (Laragon) only: REVERB_HOST=quran.test, REVERB_SCHEME=https and
# Reverb serves TLS with the local certificate. Leave empty on the server (Nginx handles TLS).
REVERB_TLS_CERT=
REVERB_TLS_KEY=

# ---------------------------------------------------------------
# WhatsApp: log (writes to laravel.log) | cloud (Meta WhatsApp Cloud API)
# ---------------------------------------------------------------
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=ar

# ---------------------------------------------------------------
# Push notifications on phones and computers (Firebase Cloud Messaging)
# Firebase console > Project settings:
#   General > Your apps > web app (firebaseConfig): API key, app ID, messaging sender ID
#   Cloud Messaging > Web Push certificates: the key pair (public)
#   Service accounts > Generate new private key: save the JSON file (secret) at
#   storage/app/private/firebase-credentials.json, or set its path below.
# ---------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=
# FIREBASE_CREDENTIALS=storage/app/private/firebase-credentials.json

# Vowel (tashkeel) check of recitations: the service in transcriber/ (npm install && npm start).
# Example: TRANSCRIBER_URL=http://127.0.0.1:8787 (use the same TRANSCRIBER_TOKEN for the service).
TRANSCRIBER_URL=
TRANSCRIBER_TOKEN=
TRANSCRIBER_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"
